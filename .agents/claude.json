{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "RUBOCOP_CACHE_ROOT": "/Users/clarksumatra/.cache"
  },
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.pgpass)",
      "Read(~/.gem/credentials)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/id_dsa)",
      "Read(**/*.pem)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)"
    ],
    "disableBypassPermissionsMode": "disable",
    "additionalDirectories": [
      "~/Codespace",
      "~/.claude"
    ]
  },
  "model": "claude-opus-4-8",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '(now | todate) + \" \" + (.tool_input.command | gsub(\"\\n\"; \" \"))' >> ~/.claude/bash-log.txt 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command'); case \"$cmd\" in *'worktree add'*) printf '%s' \"$cmd\" | grep -qE 'Codespace/[^/ ]+\\.worktrees/' || echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Worktrees must live at ~/Codespace/<repo>.worktrees/<name>, e.g. ~/Codespace/monolith.worktrees/HDR-1234-feat-slug. Re-run with that absolute path.\"}}';; esac"
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -z \"$(jq -r '.tool_input.path // empty')\" ]; then echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Do not create worktrees with EnterWorktree (.claude/worktrees). Create with git worktree add ~/Codespace/<repo>.worktrees/<name> <branch>, then enter it with EnterWorktree path.\"}}'; fi"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "mongodb@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "*.githubcopilot.com",
        "rubygems.org",
        "index.rubygems.org",
        "cache.ruby-lang.org",
        "hex.pm",
        "*.hex.pm",
        "nodejs.org",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "codeartifact.ap-northeast-1.amazonaws.com",
        "sts.amazonaws.com",
        "sts.ap-northeast-1.amazonaws.com",
        "tablesolution.com",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com",
        "download.cypress.io",
        "cdn.cypress.io",
        "sentry.io",
        "mcp.atlassian.com",
        "auth.atlassian.com",
        "api.atlassian.com",
        "tablecheck.atlassian.net"
      ],
      "allowUnixSockets": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/Codespace",
        "~/.claude",
        "~/.asdf",
        "~/.rvm",
        "~/.cache/rubocop_cache"
      ],
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        "~/Codespace",
        "~/.cache",
        "~/.claude",
        "~/.hex",
        "~/.gitconfig",
        "~/.zshrc",
        "~/.zprofile",
        "~/.zshenv",
        "~/.config",
        "~/.asdf",
        "~/.mix",
        "~/.nvm",
        "~/.rvm"
      ]
    }
  },
  "effortLevel": "high"
}
