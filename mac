#!/bin/sh

# Welcome to the thoughtbot laptop script!
# Be prepared to turn your laptop (or desktop, no haters here)
# into an awesome development machine.

# shellcheck disable=SC3043

fancy_echo() {
  local fmt="$1"; shift

  # shellcheck disable=SC2059
  printf "\\n$fmt\\n" "$@"
}

append_to_zshrc() {
  local text="$1" zshrc
  local skip_new_line="${2:-0}"

  if [ -w "$HOME/.zshrc.local" ]; then
    zshrc="$HOME/.zshrc.local"
  else
    zshrc="$HOME/.zshrc"
  fi

  if ! grep -Fqs "$text" "$zshrc"; then
    if [ "$skip_new_line" -eq 1 ]; then
      printf "%s\\n" "$text" >> "$zshrc"
    else
      printf "\\n%s\\n" "$text" >> "$zshrc"
    fi
  fi
}

# shellcheck disable=SC2154
trap 'ret=$?; test $ret -ne 0 && printf "failed\n\n" >&2; exit $ret' EXIT

set -e

if [ ! -d "$HOME/.bin/" ]; then
  mkdir "$HOME/.bin"
fi

if [ ! -f "$HOME/.zshrc" ]; then
  touch "$HOME/.zshrc"
fi

# shellcheck disable=SC2016
append_to_zshrc 'export PATH="$HOME/.bin:$PATH"'

# Determine Homebrew prefix
arch="$(uname -m)"
if [ "$arch" = "arm64" ]; then
  HOMEBREW_PREFIX="/opt/homebrew"
else
  HOMEBREW_PREFIX="/usr/local"
fi

update_shell() {
  local shell_path;
  shell_path="$(command -v zsh)"

  fancy_echo "Changing your shell to zsh ..."
  if ! grep "$shell_path" /etc/shells > /dev/null 2>&1 ; then
    fancy_echo "Adding '$shell_path' to /etc/shells"
    sudo sh -c "echo $shell_path >> /etc/shells"
  fi
  sudo chsh -s "$shell_path" "$USER"
}

case "$SHELL" in
  */zsh)
    if [ "$(command -v zsh)" != "$HOMEBREW_PREFIX/bin/zsh" ] ; then
      update_shell
    fi
    ;;
  *)
    update_shell
    ;;
esac

# checks architecture
if [ "$(uname -m)" = "arm64" ]
  then
  # checks if Rosetta is already installed
  if ! pkgutil --pkg-info=com.apple.pkg.RosettaUpdateAuto > /dev/null 2>&1
  then
    echo "Installing Rosetta"
    # Installs Rosetta2
    softwareupdate --install-rosetta --agree-to-license
  else
    echo "Rosetta is installed"
  fi
fi


gem_install_or_update() {
  if gem list "$1" --installed > /dev/null; then
    gem update "$@"
  else
    gem install "$@"
  fi
}

if ! command -v brew >/dev/null; then
  fancy_echo "Installing Homebrew ..."
    /bin/bash -c \
      "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    append_to_zshrc "eval \"\$($HOMEBREW_PREFIX/bin/brew shellenv)\""

    export PATH="$HOMEBREW_PREFIX/bin:$PATH"
fi

if brew list | grep -Fq brew-cask; then
  fancy_echo "Uninstalling old Homebrew-Cask ..."
  brew uninstall --force brew-cask
fi

# Homebrew forks its auto-update into the background, so an update started by an
# earlier `brew` call can still hold the update lock when we get here. Wait it
# out instead of aborting: the rest of the run works against the taps already on
# disk, and every `brew` command below auto-updates on its own anyway.
update_homebrew() {
  local attempt=1

  while [ "$attempt" -le 5 ]; do
    if brew update --force; then # https://github.com/Homebrew/brew/issues/1151
      return 0
    fi

    fancy_echo "Homebrew update lock is held, retrying in 15s (%d/5) ..." "$attempt"
    sleep 15
    attempt=$((attempt + 1))
  done

  fancy_echo "Skipping Homebrew update: another process still holds the update lock."
}

fancy_echo "Updating Homebrew formulae ..."
update_homebrew
brew bundle --file=- <<EOF
# Unix
brew "universal-ctags"
brew "fzf"
brew "git"
brew "openssl"
brew "rcm"
brew "reattach-to-user-namespace"
brew "the_silver_searcher"
brew "tmux"
brew "vim"
brew "watchman"
brew "zsh"

# Image manipulation
brew "imagemagick"

# PDF Rendering
brew "poppler"

# Programming language prerequisites and package managers
brew "libyaml" # should come after openssl
brew "coreutils"
brew "yarn"
cask "gpg-suite-no-mail"

# Databases
brew "postgresql@17", restart_service: :changed
brew "redis", restart_service: :changed

# Development Tools
brew "cspell"
brew "gh"
brew "gitleaks"
brew "trivy"
cask "1password-cli"
cask "claude-code"
cask "codex"
EOF

fancy_echo "Configuring asdf version manager ..."
if [ ! -d "$HOME/.asdf" ]; then
  brew install asdf
  # shellcheck disable=SC2016
  append_to_zshrc 'export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"' 1
else
  brew upgrade asdf
fi

alias install_asdf_plugin=add_or_update_asdf_plugin
add_or_update_asdf_plugin() {
  local name="$1"
  local url="$2"

  if ! asdf plugin list | grep -Fq "$name"; then
    asdf plugin add "$name" "$url"
  else
    asdf plugin update "$name"
  fi
}

export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"
add_or_update_asdf_plugin "ruby" "https://github.com/asdf-vm/asdf-ruby.git"
add_or_update_asdf_plugin "nodejs" "https://github.com/asdf-vm/asdf-nodejs.git"
add_or_update_asdf_plugin "erlang" "https://github.com/asdf-vm/asdf-erlang.git"
add_or_update_asdf_plugin "elixir" "https://github.com/asdf-vm/asdf-elixir.git"
add_or_update_asdf_plugin "python" "https://github.com/asdf-community/asdf-python.git"

install_asdf_language() {
  local language="$1"
  local version
  version="$(asdf list all "$language" | grep -v "[a-z]" | tr -s '\n' | tail -1)"

  if ! asdf list "$language" | grep -Fq "$version"; then
    asdf install "$language" "$version"
    asdf set --home "$language" "$version"
  fi
}

fancy_echo "Installing latest Ruby ..."
install_asdf_language "ruby"
gem update --system
number_of_cores=$(sysctl -n hw.ncpu)
bundle config set --global jobs $((number_of_cores - 1))

fancy_echo "Installing latest Node ..."
install_asdf_language "nodejs"

fancy_echo "Installing latest Python ..."
install_asdf_language "python"

fancy_echo "Linking configuration ..."

symlink_path() {
  local target="$1" link="$2"

  if [ ! -e "$target" ]; then
    fancy_echo "Skipping %s (%s not found)" "$link" "$target"
    return
  fi

  if [ -L "$link" ]; then
    [ "$(readlink "$link")" = "$target" ] && return
    rm "$link"
  elif [ -e "$link" ]; then
    mv "$link" "$link.backup"
    fancy_echo "Backed up existing %s to %s.backup" "$link" "$link"
  fi

  ln -s "$target" "$link"
}

PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
AGENTS_DIR="$PROJECT_DIR/.agents"

# Agents
AGENTS_GLOBAL_DIR="$HOME/.agents"

# Earlier revisions pointed ~/.agents at the repository. The links below need a
# real directory, or mkdir resolves the old symlink and they land in the repo.
[ -L "$AGENTS_GLOBAL_DIR" ] && rm "$AGENTS_GLOBAL_DIR"

mkdir -p "$AGENTS_GLOBAL_DIR"
symlink_path "$AGENTS_DIR/AGENTS.md" "$AGENTS_GLOBAL_DIR/AGENTS.md"
symlink_path "$PROJECT_DIR/rules" "$AGENTS_GLOBAL_DIR/rules"
symlink_path "$PROJECT_DIR/skills" "$AGENTS_GLOBAL_DIR/skills"
symlink_path "$PROJECT_DIR/skills-lock.json" "$AGENTS_GLOBAL_DIR/.skills-lock.json"

# Standup journal and cross-repo rejection knowledge base — machine-local state
# that outlives a session. Provisioned directly under ~/.agents rather than
# symlinked from the repo, because Codex's Seatbelt sandbox rejects symlinked
# writable roots (ADR 0008). Both directories are already under ~, so they
# persist across checkouts and need no gitignore discipline to stay unpublished.
#
# Migrate existing symlinks from the old provisioning (ADR 0004): remove the
# symlink, create a real directory, and move any existing content over.
for dir in standup out-of-scope; do
  path="$AGENTS_GLOBAL_DIR/$dir"
  if [ -L "$path" ]; then
    old="$(readlink "$path")"
    rm "$path"
    mkdir -p "$path"
    if [ -d "$old" ]; then
      cp -a "$old/." "$path/" 2>/dev/null || true
    fi
  else
    mkdir -p "$path"
  fi
done

# Claude
CLAUDE_GLOBAL_DIR="$HOME/.claude"
mkdir -p "$CLAUDE_GLOBAL_DIR"
symlink_path "$AGENTS_GLOBAL_DIR/AGENTS.md" "$CLAUDE_GLOBAL_DIR/CLAUDE.md"
symlink_path "$AGENTS_GLOBAL_DIR/rules" "$CLAUDE_GLOBAL_DIR/rules"
symlink_path "$AGENTS_GLOBAL_DIR/skills" "$CLAUDE_GLOBAL_DIR/skills"
symlink_path "$PROJECT_DIR/.claude/settings.json" "$CLAUDE_GLOBAL_DIR/settings.json"

# Codex
CODEX_GLOBAL_DIR="$HOME/.codex"
mkdir -p "$CODEX_GLOBAL_DIR"
symlink_path "$AGENTS_GLOBAL_DIR/AGENTS.md" "$CODEX_GLOBAL_DIR/AGENTS.md"
symlink_path "$PROJECT_DIR/.codex/rules" "$CODEX_GLOBAL_DIR/rules"
symlink_path "$AGENTS_GLOBAL_DIR/skills" "$CODEX_GLOBAL_DIR/skills"
# config.toml is git-ignored and machine-local: Codex needs an absolute path for
# the 1Password Unix-socket rule (no ~ expansion), so generate it from the
# tracked template, substituting the home-directory placeholder with $HOME.
sed "s|__HOME__|$HOME|g" "$PROJECT_DIR/.codex/config.toml.template" > "$PROJECT_DIR/.codex/config.toml"
symlink_path "$PROJECT_DIR/.codex/config.toml" "$CODEX_GLOBAL_DIR/config.toml"

# Cursor
CURSOR_GLOBAL_DIR="$HOME/.cursor"
mkdir -p "$CURSOR_GLOBAL_DIR"
symlink_path "$PROJECT_DIR/.cursor/cli-config.json" "$CURSOR_GLOBAL_DIR/cli-config.json"
symlink_path "$PROJECT_DIR/.cursor/hooks.json" "$CURSOR_GLOBAL_DIR/hooks.json"
symlink_path "$AGENTS_GLOBAL_DIR/rules" "$CURSOR_GLOBAL_DIR/rules"
symlink_path "$AGENTS_GLOBAL_DIR/skills" "$CURSOR_GLOBAL_DIR/skills"

# Root context map — optional, machine-local, git-ignored. Linked into ~/.agents
# and every client only when it exists; copy .agents/references/CONTEXT-FORMAT.md
# to .agents/CONTEXT.md to create one.
if [ -e "$AGENTS_DIR/CONTEXT.md" ]; then
  symlink_path "$AGENTS_DIR/CONTEXT.md" "$AGENTS_GLOBAL_DIR/CONTEXT.md"
  symlink_path "$AGENTS_GLOBAL_DIR/CONTEXT.md" "$CLAUDE_GLOBAL_DIR/CONTEXT.md"
  symlink_path "$AGENTS_GLOBAL_DIR/CONTEXT.md" "$CODEX_GLOBAL_DIR/CONTEXT.md"
  symlink_path "$AGENTS_GLOBAL_DIR/CONTEXT.md" "$CURSOR_GLOBAL_DIR/CONTEXT.md"
fi

if [ -f "$HOME/.laptop.local" ]; then
  fancy_echo "Running your customizations from ~/.laptop.local ..."
  # shellcheck disable=SC1091
  . "$HOME/.laptop.local"
fi
