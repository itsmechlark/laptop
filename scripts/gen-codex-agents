#!/bin/sh

# Render Codex custom-agent files (.toml) from the canonical agents/*.md.
#
# agents/*.md is the single source of truth: Markdown with YAML frontmatter,
# which Claude Code and Cursor read through ~/.claude/agents and
# ~/.cursor/agents. Codex reads neither — it wants one TOML file per agent
# carrying `name`, `description`, and `developer_instructions`. So the Codex
# half is generated,
# the same way gen-cursor-rules renders .mdc files from rules/. `mac` runs this
# to produce the real output it symlinks into ~/.codex/agents; check-payload
# runs it into a temp dir to prove the translation stays well-formed.
#
# The default output is .codex/generated-agents, not .codex/agents: Codex and
# Cursor both treat a repository's .codex/agents/ as project-scope agents, and
# Cursor would then prefer these TOML copies — which carry no readonly — over
# the Markdown, inside this repository.
#
# Only name, description, and the body cross over. Codex ignores a sandbox or
# approval setting in an agent file, and has no tool allowlist or skill
# preload, which is why every body names the SKILL.md to read (ADR 0024).
#
# Usage: gen-codex-agents [OUTDIR]   (OUTDIR defaults to .codex/generated-agents)

set -e

cd "$(dirname "$0")/.."

out="${1:-.codex/generated-agents}"

mkdir -p "$out"
rm -f "$out"/*.toml

# A TOML basic string: escape backslashes and double quotes.
toml_string() {
  printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

for agent in agents/*.md; do
  [ -f "$agent" ] || continue
  stem=$(basename "$agent" .md)

  fm=$(awk 'NR == 1 && $0 != "---" { exit } NR == 1 { next } /^---$/ { exit } { print }' "$agent")
  name=$(printf '%s\n' "$fm" | sed -n 's/^name: *//p' | head -1)
  description=$(printf '%s\n' "$fm" | sed -n 's/^description: *//p' | head -1)

  if [ -z "$name" ] || [ -z "$description" ]; then
    printf '%s: frontmatter needs both name and description\n' "$agent" >&2
    exit 1
  fi

  # Values are copied verbatim, so YAML quoting or a block scalar would reach
  # Codex as literal text. check-payload enforces the same rule.
  for value in "$name" "$description"; do
    case "$value" in
      \"* | \'* | ">"* | "|"*)
        printf '%s: write name and description as plain one-line values\n' "$agent" >&2
        exit 1 ;;
    esac
  done

  body=$(awk 'body && (seen || NF) { seen = 1; print } /^---$/ { c++; if (c == 2) body = 1 }' "$agent")

  # The body goes in a multi-line literal string, which has no escapes, so the
  # one sequence it cannot hold is its own delimiter.
  case "$body" in
    *"'''"*)
      printf "%s: body contains ''' and cannot be a TOML literal string\n" "$agent" >&2
      exit 1 ;;
  esac

  {
    printf '# Generated by scripts/gen-codex-agents from agents/%s.md. Do not edit.\n' "$stem"
    printf 'name = %s\n' "$(toml_string "$name")"
    printf 'description = %s\n' "$(toml_string "$description")"
    printf "developer_instructions = '''\n%s\n'''\n" "$body"
  } >"$out/$stem.toml"
done
