{
  "version": 1,
  "editor": {
    "vimMode": false
  },
  "approvalMode": "allowlist",
  "attribution": {
    "attributeCommitsToAgent": false,
    "attributePRsToAgent": false
  },
  "permissions": {
    "allow": [
      "Write(~/.agents/standup/**)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/id_dsa)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/secrets/**)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/config/master.key)",
      "Read(**/config/credentials/*.key)",
      "Read(**/.git-credentials)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(~/.claude/bash-log.txt)",
      "Read(~/.codex/bash-log.txt)",
      "Read(~/.cursor/bash-log.txt)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.pgpass)",
      "Read(~/.gem/credentials)",
      "Read(~/.cargo/credentials)",
      "Read(~/.cargo/credentials.toml)",
      "Read(~/.pypirc)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Read(~/.local/share/fish/fish_history)",
      "Read(~/.psql_history)",
      "Read(~/.mysql_history)",
      "Read(~/.rediscli_history)",
      "Read(~/.node_repl_history)",
      "Read(~/.irb_history)",
      "Read(~/.pry_history)",
      "Write(**/.cursor/**)",
      "Write(**/.claude/settings.json)",
      "Write(**/.claude/settings.local.json)",
      "Write(**/.codex/**)",
      "Write(~/.cursor/cli-config.json)",
      "Write(~/.cursor/hooks.json)",
      "Write(~/.claude/settings.json)",
      "Write(~/.claude/settings.local.json)",
      "Write(~/.codex/config.toml)",
      "Write(~/.codex/rules/**)",
      "Shell(dd)",
      "Shell(sudo)",
      "Shell(doas)",
      "Shell(su)",
      "Shell(mkfs)",
      "Shell(fdisk)",
      "Shell(parted)",
      "Shell(shutdown)",
      "Shell(reboot)",
      "Shell(poweroff)"
    ]
  }
}
