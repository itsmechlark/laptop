{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT": "1",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "CLAUDE_CODE_MCP_ALLOWLIST_ENV": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(~/.claude/bash-log.txt)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.pgpass)",
      "Read(~/.gem/credentials)",
      "Read(~/.cargo/credentials)",
      "Read(~/.cargo/credentials.toml)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/id_dsa)",
      "Read(**/*.pem)",
      "Read(**/secrets/**)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/config/master.key)",
      "Read(**/config/credentials/*.key)",
      "Read(~/.git-credentials)",
      "Read(**/.git-credentials)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(~/.pypirc)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Read(~/.local/share/fish/fish_history)",
      "Read(~/.psql_history)",
      "Read(~/.mysql_history)",
      "Read(~/.rediscli_history)",
      "Read(~/.node_repl_history)",
      "Read(~/.irb_history)",
      "Read(~/.pry_history)",
      "Bash(chmod 777 *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(rm -R -f *)",
      "Bash(rm -f -R *)",
      "Bash(dd *)",
      "Bash(sudo *)",
      "Bash(doas *)",
      "Bash(su *)",
      "Bash(mkfs *)",
      "Bash(fdisk *)",
      "Bash(parted *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(poweroff *)",
      "mcp__plugin_mongodb_mongodb__drop-database",
      "mcp__plugin_mongodb_mongodb__drop-collection"
    ],
    "ask": [
      "Bash(git clean *)",
      "Bash(gem push *)",
      "Bash(gh *)",
      "Bash(npm publish *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git commit *)",
      "Bash(git commit)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "mcp__plugin_atlassian_atlassian__createJiraIssue",
      "mcp__plugin_atlassian_atlassian__editJiraIssue",
      "mcp__plugin_atlassian_atlassian__addCommentToJiraIssue",
      "mcp__plugin_atlassian_atlassian__transitionJiraIssue",
      "mcp__plugin_atlassian_atlassian__createIssueLink",
      "mcp__plugin_atlassian_atlassian__addWorklogToJiraIssue",
      "mcp__plugin_atlassian_atlassian__createConfluencePage",
      "mcp__plugin_atlassian_atlassian__updateConfluencePage",
      "mcp__plugin_atlassian_atlassian__createConfluenceFooterComment",
      "mcp__plugin_atlassian_atlassian__createConfluenceInlineComment",
      "mcp__smartbear-bugsnag__bugsnag_update_error",
      "Edit(**/.codex/rules/**)",
      "Edit(~/.codex/rules/**)",
      "Edit(**/.codex/config.toml)",
      "Edit(~/.codex/config.toml)",
      "Edit(**/.codex/config.toml.template)",
      "Edit(**/.cursor/cli-config.json)",
      "Edit(~/.cursor/cli-config.json)",
      "Edit(**/.cursor/hooks.json)",
      "Edit(~/.cursor/hooks.json)",
      "Edit(**/.claude/settings.json)",
      "Edit(~/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(~/.claude/settings.local.json)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "additionalDirectories": [
      "~/Codespace",
      "~/.agents",
      "~/.claude"
    ]
  },
  "model": "claude-opus-4-8",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '(now | todate) + \" \" + (.tool_input.command | gsub(\"\\n\"; \" \"))' >> ~/.claude/bash-log.txt 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command'); case \"$cmd\" in *'worktree add'*) if printf '%s' \"$cmd\" | grep -qE '~/'; then echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Worktree paths must be absolute, not ~-prefixed: a ~ path does not match git worktree list and does not expand when quoted. Re-run with an absolute path like $HOME/Codespace/<repo>.worktrees/<name>.\"}}'; elif ! printf '%s' \"$cmd\" | grep -qE 'Codespace/[^/ ]+\\.worktrees/'; then echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Worktrees must live at $HOME/Codespace/<repo>.worktrees/<name>, e.g. $HOME/Codespace/example.worktrees/ABC-1234-feat-example. Re-run with that absolute path.\"}}'; fi;; esac"
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "p=$(jq -r '.tool_input.path // empty'); if [ -z \"$p\" ]; then echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Do not create worktrees with EnterWorktree (.claude/worktrees). Create with git worktree add $HOME/Codespace/<repo>.worktrees/<name> <branch>, then enter it with EnterWorktree path.\"}}'; elif printf '%s' \"$p\" | grep -qE '^~'; then echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"EnterWorktree needs an absolute path; a ~-prefixed path does not match git worktree list. Re-run with an absolute path like $HOME/Codespace/<repo>.worktrees/<name>.\"}}'; fi"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "*.githubcopilot.com",
        "rubygems.org",
        "index.rubygems.org",
        "cache.ruby-lang.org",
        "hex.pm",
        "*.hex.pm",
        "nodejs.org",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "codeartifact.ap-northeast-1.amazonaws.com",
        "sts.amazonaws.com",
        "sts.ap-northeast-1.amazonaws.com",
        "tablesolution.com",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com",
        "download.cypress.io",
        "cdn.cypress.io",
        "sentry.io",
        "mcp.atlassian.com",
        "auth.atlassian.com",
        "api.atlassian.com",
        "tablecheck.atlassian.net",
        "slack.com",
        "*.slack.com",
        "downloads.slack-edge.com",
        "*.bugsnag.com",
        "bugsnag.mcp.smartbear.com",
        "static.rust-lang.org",
        "index.crates.io",
        "static.crates.io",
        "*.mongodb.net",
        "skills.sh"
      ],
      "allowUnixSockets": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/Codespace",
        "~/.claude",
        "~/.asdf",
        "~/.rvm",
        "~/.cache/rubocop_cache"
      ],
      "denyWrite": [
        "~/.claude/settings.json",
        "./.claude/settings.json",
        "~/.claude/settings.local.json",
        "./.claude/settings.local.json",
        "~/.codex/rules/**",
        "./.codex/rules/**",
        "~/.codex/config.toml",
        "./.codex/config.toml",
        "./.codex/config.toml.template",
        "~/.codex/rules",
        "./.codex/rules",
        "~/.cursor/cli-config.json",
        "./.cursor/cli-config.json",
        "~/.cursor/hooks.json",
        "./.cursor/hooks.json"
      ],
      "denyRead": [
        "~/",
        "~/.config/gh",
        "~/.config/gcloud/**",
        "~/.claude/.credentials.json",
        "~/.claude/bash-log.txt",
        "~/.git-credentials",
        "~/.pypirc",
        "~/.cargo/credentials",
        "~/.cargo/credentials.toml",
        "./**/.env",
        "./**/.env.*",
        "./**/secrets/**",
        "./**/*.tfstate",
        "./**/*.tfstate.*",
        "./**/config/master.key",
        "./**/config/credentials/*.key",
        "./**/*.pem",
        "./**/*.p12",
        "./**/*.pfx",
        "./**/.git-credentials",
        "./**/id_rsa",
        "./**/id_ed25519",
        "./**/id_ecdsa",
        "./**/id_dsa"
      ],
      "allowRead": [
        "~/Codespace",
        "~/.agents",
        "~/.cache",
        "~/.claude",
        "~/.claude.json",
        "~/.hex",
        "~/.gitconfig",
        "~/.zlogin",
        "~/.zshrc",
        "~/.zprofile",
        "~/.zshenv",
        "~/.config",
        "~/.asdf",
        "~/.mix",
        "~/.nvm",
        "~/.rvm",
        "~/.cargo"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "PANTHEON_API_KEY",
          "mode": "deny"
        },
        {
          "name": "CLOUDSDK_PROXY_PASSWORD",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_AUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "CLAUDE_CODE_OAUTH_TOKEN",
