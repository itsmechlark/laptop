prefix_rule(pattern = ["sudo"], decision = "forbidden", justification = "Privilege escalation is not allowed from Codex.")
prefix_rule(pattern = ["doas"], decision = "forbidden", justification = "Privilege escalation is not allowed from Codex.")
prefix_rule(pattern = ["su"], decision = "forbidden", justification = "User switching / privilege escalation is not allowed from Codex.")

prefix_rule(pattern = ["mkfs"], decision = "forbidden", justification = "Filesystem formatting is destructive.")
prefix_rule(pattern = ["fdisk"], decision = "forbidden", justification = "Disk partition mutation is destructive.")
prefix_rule(pattern = ["parted"], decision = "forbidden", justification = "Disk partition mutation is destructive.")
prefix_rule(pattern = ["dd"], decision = "forbidden", justification = "Raw disk/block device writes are destructive.")
prefix_rule(pattern = ["shutdown"], decision = "forbidden", justification = "Host shutdown is not allowed from Codex.")
prefix_rule(pattern = ["reboot"], decision = "forbidden", justification = "Host reboot is not allowed from Codex.")
prefix_rule(pattern = ["poweroff"], decision = "forbidden", justification = "Host poweroff is not allowed from Codex.")

prefix_rule(pattern = ["chmod", "777"], decision = "forbidden", justification = "World-writable permissions are not allowed.")
prefix_rule(pattern = ["chmod", "-R", "777"], decision = "forbidden", justification = "Recursive world-writable permissions are not allowed.")
prefix_rule(pattern = ["chown", "-R"], decision = "forbidden", justification = "Recursive ownership change is not allowed.")

prefix_rule(pattern = ["eval"], decision = "forbidden", justification = "Shell eval is blocked — arbitrary code execution risk.")
prefix_rule(pattern = ["diskutil", "eraseDisk"], decision = "forbidden", justification = "Disk erasure is destructive.")
prefix_rule(pattern = ["csrutil", "disable"], decision = "forbidden", justification = "Disabling System Integrity Protection is not allowed.")

prefix_rule(pattern = ["git", "push", "--force"], decision = "forbidden", justification = "Force-push is blocked. Use a normal push or obtain an explicit manual workflow outside Codex.")
prefix_rule(pattern = ["git", "push", "-f"], decision = "forbidden", justification = "Force-push is blocked.")
prefix_rule(pattern = ["git", "push", "--force-with-lease"], decision = "forbidden", justification = "Force-style pushes are blocked by the translated Claude policy.")
prefix_rule(pattern = ["git", "reset", "--hard"], decision = "forbidden", justification = "Destructive reset is blocked.")

prefix_rule(pattern = ["git", "clean", "-f"], decision = "forbidden", justification = "Forced git clean is destructive.")
prefix_rule(pattern = ["git", "clean", "-fd"], decision = "forbidden", justification = "Forced git clean is destructive.")
prefix_rule(pattern = ["git", "clean", "-df"], decision = "forbidden", justification = "Forced git clean is destructive.")
prefix_rule(pattern = ["git", "clean", "-fdx"], decision = "forbidden", justification = "Forced git clean is destructive.")
prefix_rule(pattern = ["git", "clean", "-dfx"], decision = "forbidden", justification = "Forced git clean is destructive.")

prefix_rule(pattern = ["rm", ["-rf", "-fr"]], decision = "forbidden", justification = "Recursive forced deletion is blocked.")
prefix_rule(pattern = ["rm", "-r", "-f"], decision = "forbidden", justification = "Recursive forced deletion is blocked.")
prefix_rule(pattern = ["rm", "-f", "-r"], decision = "forbidden", justification = "Recursive forced deletion is blocked.")
prefix_rule(pattern = ["rm", ["-Rf", "-fR"]], decision = "forbidden", justification = "Recursive forced deletion is blocked (capital -R).")
prefix_rule(pattern = ["rm", "-R", "-f"], decision = "forbidden", justification = "Recursive forced deletion is blocked (capital -R).")
prefix_rule(pattern = ["rm", "-f", "-R"], decision = "forbidden", justification = "Recursive forced deletion is blocked (capital -R).")

# -----------------------------------------------------------------------------
# Require approval
# -----------------------------------------------------------------------------

prefix_rule(pattern = ["git", "push"], decision = "prompt", justification = "Remote Git mutation requires approval.")
prefix_rule(pattern = ["git", "commit"], decision = "prompt", justification = "Creating a Git commit requires approval.")
prefix_rule(pattern = ["git", "clean"], decision = "prompt", justification = "Git clean requires approval.")

prefix_rule(pattern = ["rm", ["-r", "-R"]], decision = "prompt", justification = "Recursive deletion without force requires approval; the forced -rf/-Rf forms are blocked above.")

prefix_rule(pattern = ["gh"], decision = "prompt", justification = "GitHub CLI access requires approval under the translated Claude policy.")
prefix_rule(pattern = ["gem", "push"], decision = "prompt", justification = "Publishing a Ruby gem requires approval.")
prefix_rule(pattern = ["npm", "publish"], decision = "prompt", justification = "Publishing an npm package requires approval.")

prefix_rule(pattern = ["terraform", "apply"], decision = "prompt", justification = "Infrastructure mutation requires approval.")
prefix_rule(pattern = ["terraform", "destroy"], decision = "prompt", justification = "Infrastructure destruction requires approval.")
prefix_rule(pattern = ["kubectl", "apply"], decision = "prompt", justification = "Kubernetes mutation requires approval.")
prefix_rule(pattern = ["kubectl", "delete"], decision = "prompt", justification = "Kubernetes deletion requires approval.")

prefix_rule(pattern = ["curl"], decision = "prompt", justification = "External data fetch requires approval.")
prefix_rule(pattern = ["wget"], decision = "prompt", justification = "External data fetch requires approval.")
prefix_rule(pattern = ["ssh"], decision = "prompt", justification = "Remote shell access requires approval.")
