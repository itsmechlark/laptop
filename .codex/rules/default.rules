# Codex command policy.
#
# Keep this file focused on native argv-prefix decisions. Prefix rules are exact
# prefixes, so hard-deny cases whose dangerous option can legally appear later
# in argv are duplicated in the PreToolUse Bash guard in config.toml.template.
# The hook also forces non-canonical mutation forms back into a shape that these
# approval rules can reliably match.

# -----------------------------------------------------------------------------
# Forbidden: privilege escalation / host and disk destruction
# -----------------------------------------------------------------------------

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Privilege escalation is not allowed from Codex.",
    match = ["sudo true"],
)

prefix_rule(
    pattern = ["doas"],
    decision = "forbidden",
    justification = "Privilege escalation is not allowed from Codex.",
    match = ["doas true"],
)

prefix_rule(
    pattern = ["su"],
    decision = "forbidden",
    justification = "User switching / privilege escalation is not allowed from Codex.",
    match = ["su root"],
)

prefix_rule(
    pattern = [["mkfs", "fdisk", "parted", "dd"]],
    decision = "forbidden",
    justification = "Raw disk, filesystem, or partition mutation is destructive.",
    match = ["mkfs /dev/disk9", "fdisk /dev/disk9", "parted /dev/disk9", "dd if=/dev/zero of=/dev/disk9"],
)

prefix_rule(
    pattern = [["shutdown", "reboot", "poweroff"]],
    decision = "forbidden",
    justification = "Host shutdown or reboot is not allowed from Codex.",
    match = ["shutdown -h now", "reboot", "poweroff"],
)

prefix_rule(
    pattern = ["eval"],
    decision = "forbidden",
    justification = "Shell eval is blocked because it can execute dynamically constructed commands.",
    match = ["eval echo ok"],
)

prefix_rule(
    pattern = ["diskutil", "eraseDisk"],
    decision = "forbidden",
    justification = "Disk erasure is destructive and is not allowed from Codex.",
    match = ["diskutil eraseDisk APFS Scratch /dev/disk9"],
)

prefix_rule(
    pattern = ["csrutil", "disable"],
    decision = "forbidden",
    justification = "Disabling System Integrity Protection is not allowed from Codex.",
    match = ["csrutil disable"],
)

# -----------------------------------------------------------------------------
# Forbidden: destructive Git operations
# -----------------------------------------------------------------------------

prefix_rule(
    pattern = ["git", "push", ["--force", "-f", "--force-with-lease", "--force-if-includes"]],
    decision = "forbidden",
    justification = "Force-style Git pushes are blocked. Use a normal push or perform the force push manually outside Codex.",
    match = [
        "git push --force origin main",
        "git push -f origin main",
        "git push --force-with-lease origin main",
    ],
    not_match = [
        # The PreToolUse hook catches this non-prefix placement.
        "git push origin main --force",
    ],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Destructive reset is blocked. Use a non-destructive reset mode or restore selected paths explicitly.",
    match = ["git reset --hard HEAD~1"],
    not_match = [
        # The PreToolUse hook catches this legal alternative placement.
        "git reset HEAD~1 --hard",
    ],
)

prefix_rule(
    pattern = ["git", "clean", ["-f", "-fd", "-df", "-fdx", "-dfx", "--force"]],
    decision = "forbidden",
    justification = "Forced Git clean is destructive and is blocked.",
    match = ["git clean -f", "git clean -fd", "git clean --force"],
)

# -----------------------------------------------------------------------------
# Forbidden: destructive filesystem ownership / permission operations
# -----------------------------------------------------------------------------

prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-Rf", "-fR"]],
    decision = "forbidden",
    justification = "Recursive forced deletion is blocked. Remove force and use an approval-gated recursive delete if appropriate.",
    match = ["rm -rf tmp", "rm -fr tmp", "rm -Rf tmp", "rm -fR tmp"],
)

prefix_rule(
    pattern = ["rm", ["-r", "-R"], "-f"],
    decision = "forbidden",
    justification = "Recursive forced deletion is blocked. Remove force and use an approval-gated recursive delete if appropriate.",
    match = ["rm -r -f tmp", "rm -R -f tmp"],
)

prefix_rule(
    pattern = ["rm", "-f", ["-r", "-R"]],
    decision = "forbidden",
    justification = "Recursive forced deletion is blocked. Remove force and use an approval-gated recursive delete if appropriate.",
    match = ["rm -f -r tmp", "rm -f -R tmp"],
)

prefix_rule(
    pattern = ["rm", "--recursive", "--force"],
    decision = "forbidden",
    justification = "Recursive forced deletion is blocked. Remove force and use an approval-gated recursive delete if appropriate.",
    match = ["rm --recursive --force tmp"],
)

prefix_rule(
    pattern = ["rm", "--force", "--recursive"],
    decision = "forbidden",
    justification = "Recursive forced deletion is blocked. Remove force and use an approval-gated recursive delete if appropriate.",
    match = ["rm --force --recursive tmp"],
)

prefix_rule(
    pattern = ["chmod", ["777", "0777"]],
    decision = "forbidden",
    justification = "World-writable executable permissions are not allowed. Use the narrowest owner/group mode required.",
    match = ["chmod 777 tmp", "chmod 0777 tmp"],
)

prefix_rule(
    pattern = ["chmod", "-R", ["777", "0777"]],
    decision = "forbidden",
    justification = "Recursive world-writable executable permissions are not allowed.",
    match = ["chmod -R 777 tmp", "chmod -R 0777 tmp"],
)

prefix_rule(
    pattern = ["chown", ["-R", "--recursive"]],
    decision = "forbidden",
    justification = "Recursive ownership changes are not allowed from Codex.",
    match = ["chown -R user:staff tmp", "chown --recursive user:staff tmp"],
)

# -----------------------------------------------------------------------------
# Forbidden: destructive GitHub CLI operations
# -----------------------------------------------------------------------------

prefix_rule(
    pattern = ["gh", ["repo", "issue", "release", "gist", "run", "cache", "codespace", "project", "label", "ssh-key", "gpg-key"], "delete"],
    decision = "forbidden",
    justification = "GitHub CLI delete operations are destructive and blocked. Use the GitHub web UI for deliberate deletions.",
    match = ["gh repo delete owner/repo", "gh issue delete 123", "gh release delete v1.0", "gh ssh-key delete abc123"],
)

# -----------------------------------------------------------------------------
# Require approval: external writes / destructive local operations
# -----------------------------------------------------------------------------

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Remote Git mutation requires approval.",
    match = ["git push", "git push origin main"],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "prompt",
    justification = "Creating a Git commit requires approval.",
    match = ["git commit", "git commit -m message"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "Git clean requires approval. Forced forms are blocked.",
    match = ["git clean -n", "git clean -d -n"],
)

prefix_rule(
    pattern = ["rm", ["-r", "-R", "--recursive"]],
    decision = "prompt",
    justification = "Recursive deletion without force requires approval; forced recursive deletion is blocked.",
    match = ["rm -r tmp", "rm -R tmp", "rm --recursive tmp"],
)

prefix_rule(
    pattern = ["gh", "pr", ["create", "merge", "close", "edit", "review", "comment", "ready", "reopen"]],
    decision = "prompt",
    justification = "Pull-request mutations require approval.",
    match = ["gh pr create --title example", "gh pr merge 123", "gh pr close 123"],
)

prefix_rule(
    pattern = ["gh", "issue", ["create", "edit", "close", "comment", "reopen", "transfer", "pin", "unpin", "develop"]],
    decision = "prompt",
    justification = "Issue mutations require approval.",
    match = ["gh issue create --title example", "gh issue close 123", "gh issue comment 123"],
)

prefix_rule(
    pattern = ["gh", "repo", ["create", "fork", "edit", "archive", "rename"]],
    decision = "prompt",
    justification = "Repository mutations require approval.",
    match = ["gh repo create example", "gh repo fork owner/repo"],
)

prefix_rule(
    pattern = ["gh", "repo", "deploy-key"],
    decision = "prompt",
    justification = "Deploy-key management is security-sensitive.",
    match = ["gh repo deploy-key add key.pub", "gh repo deploy-key delete 12345", "gh repo deploy-key list"],
)

prefix_rule(
    pattern = ["gh", "release", ["create", "edit", "upload"]],
    decision = "prompt",
    justification = "Release mutations require approval.",
    match = ["gh release create v1.0", "gh release upload v1.0 asset.tar.gz"],
)

prefix_rule(
    pattern = ["gh", "run", ["cancel", "rerun"]],
    decision = "prompt",
    justification = "Workflow run mutations require approval.",
    match = ["gh run cancel 12345", "gh run rerun 12345"],
)

prefix_rule(
    pattern = ["gh", "workflow", ["run", "enable", "disable"]],
    decision = "prompt",
    justification = "Workflow mutations require approval.",
    match = ["gh workflow run deploy.yml", "gh workflow disable deploy.yml"],
)

prefix_rule(
    pattern = ["gh", "gist", ["create", "edit"]],
    decision = "prompt",
    justification = "Gist mutations require approval.",
    match = ["gh gist create file.txt", "gh gist edit abc123"],
)

prefix_rule(
    pattern = ["gh", ["secret", "variable"]],
    decision = "prompt",
    justification = "Secret and variable management requires approval.",
    match = ["gh secret set TOKEN", "gh secret list", "gh variable set KEY"],
)

prefix_rule(
    pattern = ["gh", "label", ["create", "edit"]],
    decision = "prompt",
    justification = "Label mutations require approval.",
    match = ["gh label create bug", "gh label edit bug"],
)

prefix_rule(
    pattern = ["gh", ["ssh-key", "gpg-key"], "add"],
    decision = "prompt",
    justification = "Key registration requires approval.",
    match = ["gh ssh-key add key.pub", "gh gpg-key add key.asc"],
)

prefix_rule(
    pattern = ["gh", "codespace", ["create", "stop", "rebuild"]],
    decision = "prompt",
    justification = "Codespace mutations require approval.",
    match = ["gh codespace create", "gh codespace stop"],
)

prefix_rule(
    pattern = ["gh", "project", ["create", "edit", "close"]],
    decision = "prompt",
    justification = "Project mutations require approval.",
    match = ["gh project create", "gh project close 1"],
)

prefix_rule(
    pattern = ["gh", "api", "graphql"],
    decision = "prompt",
    justification = "GraphQL API calls default to POST and can include mutations.",
    match = ["gh api graphql -f query={ viewer { login } }"],
)

prefix_rule(
    pattern = ["gh", "api", ["-X", "--method"], ["POST", "PUT", "PATCH", "DELETE"]],
    decision = "prompt",
    justification = "Mutating API calls require approval.",
    match = ["gh api -X POST /repos/owner/repo/issues", "gh api --method DELETE /repos/owner/repo/issues/1"],
)

prefix_rule(
    pattern = ["gh", "auth", ["login", "logout", "refresh", "switch", "setup-git"]],
    decision = "prompt",
    justification = "Authentication state changes require approval.",
    match = ["gh auth login", "gh auth logout"],
)

prefix_rule(
    pattern = ["gh", "extension", ["install", "remove", "upgrade"]],
    decision = "prompt",
    justification = "Extension management requires approval.",
    match = ["gh extension install owner/extension", "gh extension remove owner/extension"],
)

prefix_rule(
    pattern = ["gem", "push"],
    decision = "prompt",
    justification = "Publishing a Ruby gem requires approval.",
    match = ["gem push pkg/example-1.0.0.gem"],
)

prefix_rule(
    pattern = ["npm", "publish"],
    decision = "prompt",
    justification = "Publishing an npm package requires approval.",
    match = ["npm publish"],
)

prefix_rule(
    pattern = ["terraform", ["apply", "destroy"]],
    decision = "prompt",
    justification = "Terraform infrastructure mutation requires approval.",
    match = ["terraform apply", "terraform destroy"],
    not_match = [
        # The PreToolUse hook rejects this form and asks for `cd infra && terraform apply`.
        "terraform -chdir=infra apply",
    ],
)

prefix_rule(
    pattern = ["kubectl", ["apply", "delete"]],
    decision = "prompt",
    justification = "Kubernetes mutation requires approval.",
    match = ["kubectl apply -f deployment.yaml", "kubectl delete pod example"],
    not_match = [
        # The PreToolUse hook rejects this form and requires the subcommand first.
        "kubectl --context prod delete pod example",
    ],
)

# -----------------------------------------------------------------------------
# Require approval: outbound / remote command tools
# -----------------------------------------------------------------------------

prefix_rule(
    pattern = ["curl"],
    decision = "prompt",
    justification = "External data fetch requires approval.",
    match = ["curl https://example.com"],
)

prefix_rule(
    pattern = ["wget"],
    decision = "prompt",
    justification = "External data fetch requires approval.",
    match = ["wget https://example.com/file"],
)

prefix_rule(
    pattern = ["ssh"],
    decision = "prompt",
    justification = "Remote shell access requires approval.",
    match = ["ssh example.com"],
)

# -----------------------------------------------------------------------------
# Require approval: second-line sandbox for unsafe commands (srt)
# -----------------------------------------------------------------------------

# srt (the bin/srt shim -> npx @anthropic-ai/sandbox-runtime srt) runs unsafe,
# untrusted commands under its own OS sandbox. It bypasses the per-command gates
# above by design (the inner command is never the prefix), so each use is gated
# by a single approval prompt instead. See AGENTS.md parity section and ADR 0015.
prefix_rule(
    pattern = ["srt"],
    decision = "prompt",
    justification = "The srt sandbox wrapper runs unsafe commands; each use requires approval.",
    match = ["srt npm install", "srt curl https://example.com"],
)
