#:schema https://developers.openai.com/codex/config-schema.json

# Codex config. Source of truth: .codex/config.toml.template (git-tracked).
# `mac` generates the git-ignored .codex/config.toml from it and symlinks that
# to ~/.codex/config.toml, replacing the home-directory placeholder in the
# Unix-socket path below with this machine's $HOME — Codex needs an absolute
# path there (no ~ expansion). Edit the template, not the generated file, then
# re-run `sh mac`.

model = "gpt-5.5"
model_reasoning_effort = "medium"
plan_mode_reasoning_effort = "high"

approval_policy = "on-request"
approvals_reviewer = "user"
default_permissions = "developer"

allow_login_shell = true

web_search = "cached"

# Byte budget for AGENTS.md content, counted across the global and project files
# together. The 32 KiB default truncates mid-file with no notice in the TUI — only
# a tracing warning — and the payload here already exceeds it: ~19.5 KB of global
# standards plus a ~32.2 KB repo AGENTS.md. Under the default, this repo's own
# instructions get cut inside "Agent-client configuration parity" and Codex never
# sees the code style, verification, or commit conventions below it. 64 KiB leaves
# headroom for both files to grow.
# Claude Code has no equivalent knob (it warns at 40k chars and skips
# only past 4 MiB), so this is per-client tuning, not shared policy.
project_doc_max_bytes = 65536

[features]
hooks = true
# Required for [permissions.developer.network.domains] to be enforced.
network_proxy = true
# Leave code execution to the sandboxed shell; the JS REPL is a second, separately
# governed execution path this profile does not need.
js_repl = false
memories = true

# Scrub likely credentials from subprocess environments.
[shell_environment_policy]
inherit = "all"
ignore_default_excludes = false
experimental_use_profile = false

[shell_environment_policy.filters]
"DATABASE_URL" = "exclude"
"REDIS_URL" = "exclude"
"RAILS_MASTER_KEY" = "exclude"
"PGPASSWORD" = "exclude"
"NPM_TOKEN" = "exclude"
"GEM_HOST_API_KEY" = "exclude"
"*_PASSWORD" = "exclude"
"*_SECRET" = "exclude"
"*_TOKEN" = "exclude"
"*_PRIVATE_KEY" = "exclude"
"*_API_KEY" = "exclude"
"*_KEY" = "exclude"
"*_CREDENTIALS" = "exclude"

[shell_environment_policy.set]
WRANGLER_LOG_PATH = "/tmp/wrangler"

# -----------------------------------------------------------------------------
# Filesystem + network permission profile
# -----------------------------------------------------------------------------

[permissions.developer]
description = "Workspace development with secret isolation and allowlisted network access"
extends = ":workspace"

[permissions.developer.filesystem]
# Deny the host by default, then reopen only the runtime/tooling paths required.
":root" = "deny"
":minimal" = "read"

glob_scan_max_depth = 8

# Codex Specific
"/System/Library/OpenSSL/openssl.cnf" = "read"

# Development/worktree area and selected tool/runtime state.
"/opt/homebrew" = "read"
# The bin/srt shim (npx @anthropic-ai/sandbox-runtime srt), on PATH via ~/.bin.
"~/.bin" = "read"
"~/Codespace" = "write"
"~/.agents" = "read"
# Narrows the read grant above for the directories an agent writes under
# ~/.agents: the standup skill's journal, the cross-repo rejection knowledge
# base, and the fallback home for each durable artifact a skill authors when the
# repository has no directory for it (ADR 0014). Provisioned by mac as real
# directories (not symlinks) so Codex's Seatbelt sandbox accepts them as
# writable roots (ADR 0008). ~/.agents/skills and ~/.agents/rules are
# deliberately absent: they resolve into this repo and are the agent's own
# instructions.
"~/.agents/standup" = "write"
"~/.agents/out-of-scope" = "write"
"~/.agents/lore" = "write"
"~/.agents/specs" = "write"
"~/.agents/plans" = "write"
"~/.agents/prds" = "write"
"~/.agents/slices" = "write"
"~/.agents/adr" = "write"
"~/.agents/handoffs" = "write"
"~/.claude" = "write"
# Self-policy guard: the Claude settings files are enforced policy. Keep them
# readable but never agent-writable (this narrows the ~/.claude write grant
# above). Repo copies are guarded under [...":workspace_roots"] below; see
# AGENTS.md "Agent-client configuration parity".
"~/.claude/settings.json" = "read"
"~/.claude/settings.local.json" = "read"
# Self-policy guard: the srt second-line sandbox config, readable for review but
# never agent-writable. Global cargo governing unsafe commands. See AGENTS.md
# "Agent-client configuration parity" and ADR 0015.
"~/.srt-settings.json" = "read"
"~/.cache" = "read"
"~/.cache/rubocop_cache" = "write"
"~/.cache/gem" = "write"
# prisma generate calls utime() on the cached engine binaries on every run.
# Engine downloads stay blocked regardless: binaries.prisma.sh is not an
# allowed domain, so only already-fetched engines are reachable.
"~/.cache/prisma" = "write"
# wrangler's global config dir on macOS (env-paths; no override, and the
# ~/.wrangler legacy path is only used when it already exists). It writes
# metrics.json on every invocation to mint a device id, even with telemetry
# off. Inert JSON: metrics, dev service registry, debug logs.
"~/Library/Preferences/.wrangler" = "write"
"~/.hex" = "read"
"~/.gitconfig" = "read"
"~/.zlogin" = "read"
"~/.zshrc" = "read"
"~/.zprofile" = "read"
"~/.zshenv" = "read"
"~/.config" = "read"
# Machine-wide Trivy config, reached through the bin/trivy shim (~/.bin, read
# above). Explicit though ~/.config already grants it — the read path the DoD
# vuln scan depends on. See AGENTS.md "Agent-client configuration parity".
"~/.config/trivy" = "read"
"~/.asdf" = "write"
"~/.mix" = "read"
"~/.nvm" = "read"
"~/.rvm" = "write"
"~/.cargo" = "read"
"~/.pulumi/plugins" = "read"
"~/.ssh" = "deny"
"~/.aws" = "deny"
"~/.gnupg" = "deny"
"~/.config/gh" = "deny"
"~/.config/gcloud" = "deny"
"~/.azure" = "deny"
"~/.kube" = "deny"
"~/.claude/.credentials.json" = "deny"
# Readable for CLI-config lookups, mirroring Claude's sandbox allowRead. Claude
# opens this only to sandboxed bash and keeps its Read tool denied; Codex can't
# split tool from shell, so its read tool can see the file (may hold an OAuth
# token) too. See AGENTS.md "Agent-client configuration parity".
"~/.claude.json" = "read"
"~/.claude/bash-log.txt" = "deny"
"~/.codex/bash-log.txt" = "deny"
"~/.netrc" = "deny"
"~/.npmrc" = "deny"
"~/.docker/config.json" = "deny"
"~/.pgpass" = "deny"
"~/.gem/credentials" = "deny"
"~/.cargo/credentials" = "deny"
"~/.cargo/credentials.toml" = "deny"
"~/.git-credentials" = "deny"
"~/.pypirc" = "deny"
"~/.bash_history" = "deny"
"~/.zsh_history" = "deny"
"~/.local/share/fish/fish_history" = "deny"
"~/.psql_history" = "deny"
"~/.mysql_history" = "deny"
"~/.rediscli_history" = "deny"
"~/.node_repl_history" = "deny"
"~/.irb_history" = "deny"
"~/.pry_history" = "deny"

[permissions.developer.filesystem.":workspace_roots"]
"." = "write"
"**/.env" = "deny"
"**/.env.*" = "deny"
"**/secrets/**" = "deny"
"**/*.tfstate" = "deny"
"**/*.tfstate.*" = "deny"
"**/config/master.key" = "deny"
"**/config/credentials/*.key" = "deny"
"**/*.pem" = "deny"
"**/*.p12" = "deny"
"**/*.pfx" = "deny"
"**/.git-credentials" = "deny"
"**/id_rsa" = "deny"
"**/id_ed25519" = "deny"
"**/id_ecdsa" = "deny"
"**/id_dsa" = "deny"

# Self-policy guard: this repo's own governance files stay readable for review
# but never agent-writable, so a run steered by untrusted input can't silently
# rewrite its own policy. .codex/** is the Codex policy; .claude/settings*.json
# is the Claude policy; .cursor/** is the Cursor policy. See AGENTS.md
# "Agent-client configuration parity".
# `read`/`write` rules must be exact paths or simple trailing `/**` subtrees.
# These paths are relative to every effective workspace root.
".codex/**" = "read"
".claude/settings.json" = "read"
".claude/settings.local.json" = "read"
".cursor/**" = "read"
"srt-settings.json" = "read"
"bin/srt" = "read"

[permissions.developer.network]
enabled = true
# Match Claude: restrict hosts, not HTTP methods on allowed hosts.
mode = "full"
# Preserves the supplied Claude setting for local-development workflows.
# This is broader than the default Codex local/private-network guard.
allow_local_binding = true
allow_upstream_proxy = false
dangerously_allow_non_loopback_proxy = false
dangerously_allow_all_unix_sockets = false

[permissions.developer.network.domains]
"github.com" = "allow"
"*.github.com" = "allow"
"*.githubusercontent.com" = "allow"
"*.githubcopilot.com" = "allow"
"rubygems.org" = "allow"
"index.rubygems.org" = "allow"
"cache.ruby-lang.org" = "allow"
"hex.pm" = "allow"
"*.hex.pm" = "allow"
"nodejs.org" = "allow"
"registry.npmjs.org" = "allow"
"registry.yarnpkg.com" = "allow"
# Trivy vulnerability-DB registries: primary mirror.gcr.io, fallback ghcr.io
# (ghcr blobs come from *.githubusercontent.com, already allowed). See ADR 0019.
"ghcr.io" = "allow"
"mirror.gcr.io" = "allow"
"codeartifact.ap-northeast-1.amazonaws.com" = "allow"
"sts.amazonaws.com" = "allow"
"sts.ap-northeast-1.amazonaws.com" = "allow"
"tablesolution.com" = "allow"
"cdn.playwright.dev" = "allow"
"playwright.download.prss.microsoft.com" = "allow"
"download.cypress.io" = "allow"
"cdn.cypress.io" = "allow"
"sentry.io" = "allow"
"mcp.atlassian.com" = "allow"
"auth.atlassian.com" = "allow"
"api.atlassian.com" = "allow"
"tablecheck.atlassian.net" = "allow"
"slack.com" = "allow"
"*.slack.com" = "allow"
"downloads.slack-edge.com" = "allow"
"*.bugsnag.com" = "allow"
"bugsnag.mcp.smartbear.com" = "allow"
"static.rust-lang.org" = "allow"
"index.crates.io" = "allow"
"static.crates.io" = "allow"
"*.mongodb.net" = "allow"
"skills.sh" = "allow"
"anthropic.com" = "allow"
"*.anthropic.com" = "allow"
"rspec.rubystyle.guide" = "allow"
"mcp.excalidraw.com" = "allow"
"mcp.deepwiki.com" = "allow"
"*.pulumi.com" = "allow"
"localhost" = "allow"
"127.0.0.1" = "allow"
"::1" = "allow"

# Codex requires an ABSOLUTE path here (no ~ expansion), which is why config.toml
# is generated from this template: the placeholder below is replaced with $HOME
# at install time. Mirrors Claude's sandbox.network.allowUnixSockets entry (the
# 1Password SSH agent), so SSH-based git push and SSH commit signing work under
# the sandbox.
[permissions.developer.network.unix_sockets]
"__HOME__/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" = "allow"

