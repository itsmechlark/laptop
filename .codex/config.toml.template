#:schema https://developers.openai.com/codex/config-schema.json

# Codex config. Source of truth: .codex/config.toml.template (git-tracked).
# `mac` generates the git-ignored .codex/config.toml from it and symlinks that
# to ~/.codex/config.toml, replacing the home-directory placeholder in the
# Unix-socket path below with this machine's $HOME — Codex needs an absolute
# path there (no ~ expansion). Edit the template, not the generated file, then
# re-run `sh mac`.

model = "gpt-5.6"
model_reasoning_effort = "high"
plan_mode_reasoning_effort = "high"

approval_policy = "on-request"
approvals_reviewer = "user"
default_permissions = "developer"

allow_login_shell = true

web_search = "cached"

[features]
hooks = true
# Required for [permissions.developer.network.domains] to be enforced.
network_proxy = true

# Scrub likely credentials from subprocess environments.
[shell_environment_policy]
inherit = "all"
ignore_default_excludes = false
experimental_use_profile = false

[shell_environment_policy.filters]
"DATABASE_URL" = "exclude"
"REDIS_URL" = "exclude"
"RAILS_MASTER_KEY" = "exclude"
"PGPASSWORD" = "exclude"
"NPM_TOKEN" = "exclude"
"GEM_HOST_API_KEY" = "exclude"
"*_PASSWORD" = "exclude"
"*_SECRET" = "exclude"
"*_TOKEN" = "exclude"
"*_PRIVATE_KEY" = "exclude"
"*_API_KEY" = "exclude"
"*_KEY" = "exclude"
"*_CREDENTIALS" = "exclude"

# -----------------------------------------------------------------------------
# Filesystem + network permission profile
# -----------------------------------------------------------------------------

[permissions.developer]
description = "Workspace development with secret isolation and allowlisted network access"
extends = ":workspace"

[permissions.developer.filesystem]
# Deny the host by default, then reopen only the runtime/tooling paths required.
":root" = "deny"
":minimal" = "read"

glob_scan_max_depth = 8

# Development/worktree area and selected tool/runtime state.
"/opt/homebrew" = "read"
"~/Codespace" = "write"
"~/.agents" = "read"
# Narrows the read grant above for the two directories an agent writes under
# ~/.agents: the standup skill's journal, and the cross-repo rejection knowledge
# base that triage writes and slice and draft-spec read. Both machine-local and
# git-ignored; see AGENTS.md "Agent-client configuration parity".
"~/.agents/standup" = "write"
"~/.agents/out-of-scope" = "write"
"~/.claude" = "write"
# Self-policy guard: the Claude settings files are enforced policy. Keep them
# readable but never agent-writable (this narrows the ~/.claude write grant
# above). Repo copies are guarded under [...":workspace_roots"] below; see
# AGENTS.md "Agent-client configuration parity".
"~/.claude/settings.json" = "read"
"~/.claude/settings.local.json" = "read"
"~/.cache" = "read"
"~/.cache/rubocop_cache" = "write"
"~/.cache/gem" = "write"
"~/.hex" = "read"
"~/.gitconfig" = "read"
"~/.zlogin" = "read"
"~/.zshrc" = "read"
"~/.zprofile" = "read"
"~/.zshenv" = "read"
"~/.config" = "read"
"~/.asdf" = "write"
"~/.mix" = "read"
"~/.nvm" = "read"
"~/.rvm" = "write"
"~/.cargo" = "read"
"~/.ssh" = "deny"
"~/.aws" = "deny"
"~/.gnupg" = "deny"
"~/.config/gh" = "deny"
"~/.config/gcloud" = "deny"
"~/.azure" = "deny"
"~/.kube" = "deny"
"~/.claude/.credentials.json" = "deny"
# Readable for CLI-config lookups, mirroring Claude's sandbox allowRead. Claude
# opens this only to sandboxed bash and keeps its Read tool denied; Codex can't
# split tool from shell, so its read tool can see the file (may hold an OAuth
# token) too. See AGENTS.md "Agent-client configuration parity".
"~/.claude.json" = "read"
"~/.claude/bash-log.txt" = "deny"
"~/.codex/bash-log.txt" = "deny"
"~/.netrc" = "deny"
"~/.npmrc" = "deny"
"~/.docker/config.json" = "deny"
"~/.pgpass" = "deny"
"~/.gem/credentials" = "deny"
"~/.cargo/credentials" = "deny"
"~/.cargo/credentials.toml" = "deny"
"~/.git-credentials" = "deny"
"~/.pypirc" = "deny"
"~/.bash_history" = "deny"
"~/.zsh_history" = "deny"
"~/.local/share/fish/fish_history" = "deny"
"~/.psql_history" = "deny"
"~/.mysql_history" = "deny"
"~/.rediscli_history" = "deny"
"~/.node_repl_history" = "deny"
"~/.irb_history" = "deny"
"~/.pry_history" = "deny"

[permissions.developer.filesystem.":workspace_roots"]
"." = "write"
"**/.env" = "deny"
"**/.env.*" = "deny"
"**/secrets/**" = "deny"
"**/*.tfstate" = "deny"
"**/*.tfstate.*" = "deny"
"**/config/master.key" = "deny"
"**/config/credentials/*.key" = "deny"
"**/*.pem" = "deny"
"**/*.p12" = "deny"
"**/*.pfx" = "deny"
"**/.git-credentials" = "deny"
"**/id_rsa" = "deny"
"**/id_ed25519" = "deny"
"**/id_ecdsa" = "deny"
"**/id_dsa" = "deny"

# Self-policy guard: this repo's own governance files stay readable for review
# but never agent-writable, so a run steered by untrusted input can't silently
# rewrite its own policy. .codex/** is the Codex policy; .claude/settings*.json
# is the Claude policy; .cursor/** is the Cursor policy. See AGENTS.md
# "Agent-client configuration parity".
# `read`/`write` rules must be exact paths or simple trailing `/**` subtrees.
# These paths are relative to every effective workspace root.
".codex/**" = "read"
".claude/settings.json" = "read"
".claude/settings.local.json" = "read"
".cursor/**" = "read"

[permissions.developer.network]
enabled = true
mode = "limited"
# Preserves the supplied Claude setting for local-development workflows.
# This is broader than the default Codex local/private-network guard.
allow_local_binding = true
allow_upstream_proxy = false
dangerously_allow_non_loopback_proxy = false
dangerously_allow_all_unix_sockets = false

[permissions.developer.network.domains]
"github.com" = "allow"
"*.github.com" = "allow"
"*.githubusercontent.com" = "allow"
"*.githubcopilot.com" = "allow"
"rubygems.org" = "allow"
"index.rubygems.org" = "allow"
"cache.ruby-lang.org" = "allow"
"hex.pm" = "allow"
"*.hex.pm" = "allow"
"nodejs.org" = "allow"
"registry.npmjs.org" = "allow"
"registry.yarnpkg.com" = "allow"
"codeartifact.ap-northeast-1.amazonaws.com" = "allow"
"sts.amazonaws.com" = "allow"
"sts.ap-northeast-1.amazonaws.com" = "allow"
"tablesolution.com" = "allow"
"cdn.playwright.dev" = "allow"
"playwright.download.prss.microsoft.com" = "allow"
"download.cypress.io" = "allow"
"cdn.cypress.io" = "allow"
"sentry.io" = "allow"
"mcp.atlassian.com" = "allow"
"auth.atlassian.com" = "allow"
"api.atlassian.com" = "allow"
"tablecheck.atlassian.net" = "allow"
"slack.com" = "allow"
"*.slack.com" = "allow"
"downloads.slack-edge.com" = "allow"
"*.bugsnag.com" = "allow"
"bugsnag.mcp.smartbear.com" = "allow"
"static.rust-lang.org" = "allow"
"index.crates.io" = "allow"
"static.crates.io" = "allow"
"*.mongodb.net" = "allow"
"skills.sh" = "allow"
"localhost" = "allow"
"127.0.0.1" = "allow"
"::1" = "allow"

# Codex requires an ABSOLUTE path here (no ~ expansion), which is why config.toml
# is generated from this template: the placeholder below is replaced with $HOME
# at install time. Mirrors Claude's sandbox.network.allowUnixSockets entry (the
# 1Password SSH agent), so SSH-based git push and SSH commit signing work under
# the sandbox.
[permissions.developer.network.unix_sockets]
"__HOME__/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" = "allow"

# -----------------------------------------------------------------------------
# Lifecycle hooks
# -----------------------------------------------------------------------------

[[hooks.PreToolUse]]
matcher = "^Bash$"

[[hooks.PreToolUse.hooks]]
type = "command"
command = '''jq -r '(now | todate) + " " + (.tool_input.command | gsub("\\n"; " "))' >> ~/.codex/bash-log.txt 2>/dev/null || true'''
timeout = 3

# Defense-in-depth Bash policy guard.
#
# Native .rules prefix matching remains the primary approval mechanism. This
# hook closes gaps that prefix rules cannot express safely, such as `--force`
# appearing later in argv, Git/Terraform/kubectl global options before a
# mutation subcommand, grouped rm/chown flags, and worktree destination
# validation. Hooks are guardrails rather than a complete security boundary.
#
# Requires python3 in PATH. If your bootstrap does not guarantee Python, move
# this body to a repository-controlled executable and point `command` at it.
[[hooks.PreToolUse]]
matcher = "^Bash$"

[[hooks.PreToolUse.hooks]]
type = "command"
command = '''python3 -c '
import json
import os
import re
import shlex
import sys

payload = json.load(sys.stdin)
command = payload.get("tool_input", {}).get("command", "")
home = os.path.expanduser("~")


def deny(reason):
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        }
    }))
    raise SystemExit(0)


def split_commands(script, depth=0):
    if depth > 3:
        return []

    try:
        lexer = shlex.shlex(script, posix=True, punctuation_chars=";&|")
        lexer.whitespace_split = True
        lexer.commenters = ""
        tokens = list(lexer)
    except ValueError:
        return []

    segments = []
    current = []
    for token in tokens:
        if token and all(ch in ";&|" for ch in token):
            if current:
                segments.append(current)
                current = []
        else:
            current.append(token)
    if current:
        segments.append(current)

    result = []
    for argv in segments:
        result.append(argv)
        normalized = normalize_argv(argv)
        if not normalized:
            continue
        exe = os.path.basename(normalized[0])
        if exe not in {"sh", "bash", "zsh"}:
            continue
        for index, token in enumerate(normalized[1:], start=1):
            if token == "-c" or (token.startswith("-") and not token.startswith("--") and "c" in token[1:]):
                if index + 1 < len(normalized):
                    result.extend(split_commands(normalized[index + 1], depth + 1))
                break
    return result


def normalize_argv(argv):
    argv = list(argv)
    index = 0
    while index < len(argv) and re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", argv[index]):
        index += 1
    argv = argv[index:]

    while argv:
        exe = os.path.basename(argv[0])
        if exe in {"command", "builtin", "exec", "nohup"}:
            argv = argv[1:]
            continue
        if exe == "env":
            argv = argv[1:]
            while argv and (argv[0].startswith("-") or re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", argv[0])):
                argv = argv[1:]
            continue
        break
    return argv


def option_flags(args):
    short = set()
    long = set()
    for token in args:
        if token == "--":
            break
        if token.startswith("--"):
            long.add(token.split("=", 1)[0])
        elif token.startswith("-") and token != "-":
            short.update(token[1:])
    return short, long


def first_subcommand(args, names):
    for index, token in enumerate(args):
        if token in names:
            return index, token
    return None, None


def chmod_world_writable(args):
    mode = None
    skip_next = False
    for token in args:
        if skip_next:
            skip_next = False
            continue
        if token == "--":
            continue
        if token == "--reference":
            skip_next = True
            continue
        if token.startswith("-"):
            continue
        mode = token
        break

    if mode is None:
        return False

    if re.fullmatch(r"[0-7]+", mode):
        return bool(int(mode[-1], 8) & 0o2)

    for clause in mode.split(","):
        match = re.fullmatch(r"([ugoa]*)([+=-])([rwxXstugo]*)", clause)
        if not match:
            continue
        who, operation, permissions = match.groups()
        targets_other = "a" in who or "o" in who
        if targets_other and operation in {"+", "="} and "w" in permissions:
            return True
    return False


def validate_worktree_path(args, worktree_index):
    tail = args[worktree_index + 2:]
    path = None
    index = 0
    options_with_value = {"-b", "-B", "--reason"}
    while index < len(tail):
        token = tail[index]
        if token == "--":
            if index + 1 < len(tail):
                path = tail[index + 1]
            break
        if token in options_with_value:
            index += 2
            continue
        if token.startswith("--reason=") or token.startswith("-b") and token != "-b" or token.startswith("-B") and token != "-B":
            index += 1
            continue
        if token.startswith("-"):
            index += 1
            continue
        path = token
        break

    if path is None:
        return
    if path.startswith("~") or not os.path.isabs(path):
        deny("Worktree paths must be absolute and must not use ~ or shell-variable prefixes. Use $HOME expanded to its absolute path under $HOME/Codespace/<repo>.worktrees/<name>.")

    codespace = os.path.normpath(os.path.join(home, "Codespace"))
    candidate = os.path.normpath(path)
    try:
        relative = os.path.relpath(candidate, codespace)
    except ValueError:
        deny("Worktrees must live at $HOME/Codespace/<repo>.worktrees/<name>.")

    parts = relative.split(os.sep)
    if relative.startswith(".." + os.sep) or relative == ".." or len(parts) != 2 or not parts[0].endswith(".worktrees") or not parts[1]:
        deny("Worktrees must live at $HOME/Codespace/<repo>.worktrees/<name>, for example $HOME/Codespace/example.worktrees/ABC-1234-feat-example.")


for raw_argv in split_commands(command):
    argv = normalize_argv(raw_argv)
    if not argv:
        continue

    exe = os.path.basename(argv[0])
    args = argv[1:]

    if exe in {"sudo", "doas", "su"}:
        deny("Privilege escalation or user switching is not allowed from Codex.")

    if exe in {"mkfs", "fdisk", "parted", "dd"}:
        deny("Raw disk, filesystem, or partition mutation is blocked as destructive.")

    if exe in {"shutdown", "reboot", "poweroff"}:
        deny("Host shutdown or reboot is not allowed from Codex.")

    if exe == "eval":
        deny("Shell eval is blocked because it can execute dynamically constructed commands.")

    if exe == "diskutil" and "eraseDisk" in args:
        deny("Disk erasure is destructive and is not allowed from Codex.")

    if exe == "csrutil" and "disable" in args:
        deny("Disabling System Integrity Protection is not allowed from Codex.")

    if exe == "git":
        sub_index, subcommand = first_subcommand(args, {"push", "commit", "clean", "reset", "worktree"})
        if subcommand == "push":
            tail = args[sub_index + 1:]
            short, long = option_flags(tail)
            if "f" in short or "--force" in long or "--force-with-lease" in long or "--force-if-includes" in long:
                deny("Force-style Git pushes are blocked. Use a normal push or perform the force push manually outside Codex.")
            if sub_index != 0:
                deny("Git push must use canonical `git push ...` form so the native approval rule cannot be bypassed. Change directory first instead of placing Git global options before `push`.")
        elif subcommand == "commit" and sub_index != 0:
            deny("Git commit must use canonical `git commit ...` form so the native approval rule cannot be bypassed. Change directory first instead of placing Git global options before `commit`.")
        elif subcommand == "clean":
            tail = args[sub_index + 1:]
            short, long = option_flags(tail)
            if "f" in short or "--force" in long:
                deny("Forced Git clean is destructive and is blocked.")
            if sub_index != 0:
                deny("Git clean must use canonical `git clean ...` form so the native approval rule cannot be bypassed. Change directory first instead of placing Git global options before `clean`.")
        elif subcommand == "reset":
            tail = args[sub_index + 1:]
            if "--hard" in tail:
                deny("Destructive `git reset --hard` is blocked.")
        elif subcommand == "worktree" and sub_index + 1 < len(args) and args[sub_index + 1] == "add":
            validate_worktree_path(args, sub_index)

    if exe == "rm":
        short, long = option_flags(args)
        recursive = "r" in short or "R" in short or "--recursive" in long
        forced = "f" in short or "--force" in long
        if recursive and forced:
            deny("Recursive forced deletion is blocked. Remove `-f`/`--force` and use an approval-gated recursive delete if appropriate.")
        if recursive and (not args or args[0] not in {"-r", "-R", "--recursive"}):
            deny("Recursive rm must place `-r`, `-R`, or `--recursive` immediately after `rm` so the native approval rule cannot be bypassed.")

    if exe == "chmod" and chmod_world_writable(args):
        deny("Making files world-writable is blocked. Use the narrowest owner/group permissions required.")

    if exe == "chown":
        short, long = option_flags(args)
        if "R" in short or "--recursive" in long:
            deny("Recursive ownership changes are blocked.")

    if exe == "terraform":
        sub_index, subcommand = first_subcommand(args, {"apply", "destroy"})
        if subcommand is not None and sub_index != 0:
            deny("Terraform mutation must use canonical `terraform apply` or `terraform destroy` form so the native approval rule cannot be bypassed. Change directory first instead of placing global options before the subcommand.")

    if exe == "kubectl":
        sub_index, subcommand = first_subcommand(args, {"apply", "delete"})
        if subcommand is not None and sub_index != 0:
            deny("kubectl mutation must put `apply` or `delete` immediately after `kubectl` so the native approval rule cannot be bypassed. Move global flags after the subcommand.")
''''
timeout = 3

# -----------------------------------------------------------------------------
# Telemetry
# -----------------------------------------------------------------------------

[otel]
log_user_prompt = false
exporter = "none"
trace_exporter = "none"
metrics_exporter = "none"

# -----------------------------------------------------------------------------
# Projects
# -----------------------------------------------------------------------------

[projects."__HOME__/Codespace/laptop"]
trust_level = "trusted"
